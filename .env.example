# ---------------------------------------------------------------
# Skdiv.Studios / CREWcasts live dashboard
# Copy to .env.local for local dev, and add the same keys in
# Vercel > Project > Settings > Environment Variables.
# Every block is OPTIONAL. A source with no keys shows as
# "Not configured" on the dashboard instead of breaking the build.
# ---------------------------------------------------------------

# --- YouTube Data API v3 -----------------------------------------
# console.cloud.google.com > new project > enable "YouTube Data API v3"
# > Credentials > Create API key. Free, 10,000 units a day.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCLPOTDs8UWyy6m-ZzkS82Xg

# --- Instagram Graph API -----------------------------------------
# Needs an Instagram Business or Creator account linked to a Facebook
# Page, plus a Meta app. See README for the full token walkthrough.
# The token expires every 60 days unless refreshed.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Optional: pin the Graph API version. Defaults to v21.0.
INSTAGRAM_GRAPH_VERSION=v21.0

# --- TikTok Display API ------------------------------------------
# Requires an approved app at developers.tiktok.com and a user
# access token. Approval can take weeks and may be declined.
TIKTOK_ACCESS_TOKEN=

# --- Spotify Web API ---------------------------------------------
# developer.spotify.com > Dashboard > Create app. Client credentials.
# NOTE: returns show and episode metadata only. Spotify does not
# expose podcast play counts through any API, to anyone.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_SHOW_ID=033VW8uMzevcsKbUVL1cB8

# --- Apple Podcasts ----------------------------------------------
# Public iTunes lookup, no key needed. Metadata only, no play counts.
APPLE_PODCAST_ID=6794767948

# --- Cron protection ---------------------------------------------
# Any random string. Vercel Cron sends it as a bearer token.
REVALIDATE_SECRET=change-me
